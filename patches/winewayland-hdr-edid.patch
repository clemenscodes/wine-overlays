@@ -37,6 +37,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(waylanddrv);
 static struct wp_image_description_v1 *scrgb_desc;
 static struct wp_image_description_v1 *bt2100_desc;
 static BOOL color_manager_initialized;
+static BOOL has_parametric, has_windows_bt2100, has_tf_pq, has_primaries_bt2020;
 
 static void image_description_failed(void *user_data, struct wp_image_description_v1 *desc,
                                      uint32_t cause, const char *message)
@@ -86,23 +87,48 @@ static void color_manager_supported_feature(void *data, struct wp_color_manager_
         scrgb_desc = (void *)-1;
         wp_image_description_v1_add_listener(desc, &image_description_listener, &scrgb_desc);
     }
-    if (feature == WP_COLOR_MANAGER_V1_FEATURE_WINDOWS_BT2100 && (desc = wp_color_manager_v1_create_windows_bt2100(manager)))
-    {
-        bt2100_desc = (void *)-1;
-        wp_image_description_v1_add_listener(desc, &image_description_listener, &bt2100_desc);
-    }
+    if (feature == WP_COLOR_MANAGER_V1_FEATURE_WINDOWS_BT2100) has_windows_bt2100 = TRUE;
+    if (feature == WP_COLOR_MANAGER_V1_FEATURE_PARAMETRIC) has_parametric = TRUE;
 }
 
 static void color_manager_supported_named_tf(void *data, struct wp_color_manager_v1 *manager, uint32_t tf)
 {
+    if (tf == WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ) has_tf_pq = TRUE;
 }
 
 static void color_manager_supported_primaries(void *data, struct wp_color_manager_v1 *manager, uint32_t primaries)
 {
+    if (primaries == WP_COLOR_MANAGER_V1_PRIMARIES_BT2020) has_primaries_bt2020 = TRUE;
 }
 
 static void color_manager_done(void *data, struct wp_color_manager_v1 *manager)
 {
+    struct wp_image_description_creator_params_v1 *creator;
+    struct wp_image_description_v1 *desc = NULL;
+
+    /* HDR10 swapchains carry plain BT.2100 PQ. Describe them parametrically
+     * when possible: the compositor then knows the content spans the whole
+     * PQ range up to 10000 cd/m² and tone maps it to the output, as it does
+     * for video players. The Windows-BT.2100 description leaves the content
+     * luminance unknown, so compositors assume reference white as the peak,
+     * skip tone mapping and send the game's highlights to the display
+     * unmapped, where they clip. */
+    if (has_parametric && has_tf_pq && has_primaries_bt2020 &&
+        (creator = wp_color_manager_v1_create_parametric_creator(manager)))
+    {
+        wp_image_description_creator_params_v1_set_tf_named(creator, WP_COLOR_MANAGER_V1_TRANSFER_FUNCTION_ST2084_PQ);
+        wp_image_description_creator_params_v1_set_primaries_named(creator, WP_COLOR_MANAGER_V1_PRIMARIES_BT2020);
+        desc = wp_image_description_creator_params_v1_create(creator);
+    }
+    else if (has_windows_bt2100)
+        desc = wp_color_manager_v1_create_windows_bt2100(manager);
+
+    if (desc)
+    {
+        bt2100_desc = (void *)-1;
+        wp_image_description_v1_add_listener(desc, &image_description_listener, &bt2100_desc);
+    }
+
     color_manager_initialized = TRUE;
 }
 
@@ -123,6 +149,11 @@ void color_management_init(void)
     TRACE("Initialized image descriptors, scRGB %p BT.2100 %p\n", scrgb_desc, bt2100_desc);
 }
 
+BOOL color_management_has_bt2100(void)
+{
+    return bt2100_desc != NULL;
+}
