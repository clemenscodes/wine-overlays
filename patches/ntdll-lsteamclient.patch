index 2a42099..7d9b731 100644
--- a/dlls/ntdll/unix/signal_i386.c
+++ b/dlls/ntdll/unix/signal_i386.c
@@ -1950,6 +1950,7 @@ static BOOL handle_syscall_trap( struct thread_data *data, ucontext_t *sigcontex
  */
 static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
 {
+    void *steamclient_addr = NULL;
     ucontext_t *sigcontext = _sigcontext;
     struct thread_data *data = init_handler( sigcontext );
     void *stack = get_exception_stack( data, sigcontext );
@@ -1991,6 +1992,12 @@ static void segv_handler( int signal, siginfo_t *siginfo, void *_sigcontext )
         }
         break;
     case TRAP_x86_PAGEFLT:  /* Page fault */
+        if ((steamclient_addr = steamclient_handle_fault( siginfo->si_addr, (ERROR_sig(sigcontext) >> 1) & 0x09 )))
+        {
+            EIP_sig(sigcontext) = (intptr_t)steamclient_addr;
+            return;
+        }
+
         rec.NumberParameters = 2;
         rec.ExceptionInformation[0] = (ERROR_sig(sigcontext) >> 1) & 0x09;
         rec.ExceptionInformation[1] = (ULONG_PTR)siginfo->si_addr;
